# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.tsbuildinfo

# Playwright (installed only for the smoke test)
test-results/
playwright-report/

# Stockfish engine binaries (copied from node_modules by scripts/copy-engine.mjs)
public/stockfish/

# Local env / editor
.env
.env.local
*.local
.DS_Store
.vscode/*
!.vscode/extensions.json

# Wrangler local state (local Durable Object storage, dev cache)
.wrangler/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lichess puzzle database (300MB; fetched on demand by scripts/import-puzzles.mjs)
.cache/
