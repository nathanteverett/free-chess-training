{
  "name": "free-chess-training",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open-source chess curriculum: lessons with articles, puzzles, GM games, and a free engine.",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "copy-engine": "node scripts/copy-engine.mjs",
    "generate-lessons": "node scripts/generate-lessons.mjs",
    "check-lessons": "node scripts/check-lessons.mjs",
    "import-puzzles": "node scripts/import-puzzles.mjs",
    "postinstall": "node scripts/copy-engine.mjs",
    "predev": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787 --var ALLOWED_ORIGINS:http://localhost:5173",
    "deploy:worker": "wrangler deploy",
    "prebuild": "node scripts/copy-engine.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/pages-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "chess.js": "^1.4.0",
    "react": "^18.3.1",
    "react-chessboard": "^4.7.3",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "stockfish": "^16.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260713.1",
    "@mdx-js/rollup": "^3.1.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wrangler": "^4.110.0"
  }
}
